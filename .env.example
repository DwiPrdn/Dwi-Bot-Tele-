# ==========================================
# Telegram API Credentials
# Dapatkan dari https://my.telegram.org/apps
# ==========================================
API_ID=
API_HASH=

# ==========================================
# Telegram Bot Configuration
# Dapatkan dari @BotFather di Telegram
# ==========================================
BOT_TOKEN=
BOT_USERNAME=Plendes_bot
BOT_ID=

# ==========================================
# Owner Configuration
# ID Telegram pemilik bot (angka)
# ==========================================
OWNER_ID=

# ==========================================
# AI Service Keys
# ==========================================
# Google Gemini API Keys (bisa satu atau lebih dipisah koma untuk rotasi key)
# Dapatkan dari https://aistudio.google.com/app/apikey
GEMINI_KEYS=
MODEL_NAME=gemini-3.1-flash-lite

# ==========================================
# Storage & Mirror (Opsional)
# ==========================================
# Token akun Gofile (kosongkan jika upload sebagai guest)
GOFILE_TOKEN=

# Direktori basis bot (kosongkan untuk deteksi otomatis folder saat ini)
BASE_PATH=
